otes":{"value":"<p><strong>Kampfverhalten:</strong> B&uuml;rger versuchen meist, gewaltt&auml;tigen Auseinandersetzungen aus dem Weg zu gehen. M&uuml;ssen sie sich doch einmal zur Wehr setzen, so greifen sie meist auf einen Kn&uuml;ppel oder ihren Dolch zur&uuml;ck, aber sie versuchen nach M&ouml;glichkeit zu fliehen. In &Uuml;berzahl, beispielsweise als emp&ouml;rter Mob, sind sie hingegen meist weitaus mutiger.</p>\n<p>&nbsp;</p>\n<p><strong>Flucht:</strong> individuell; sp&auml;testens nach einer Stufe Schmerz versuchen B&uuml;rger zu fliehen</p>","gmdescription":""},"Home":{"value":""}},"guidevalue":{"magical":"-","clerical":"-"},"energyfactor":{"magical":1,"clerical":1},"tradition":{"magical":"","clerical":""},"feature":{"magical":"","clerical":""},"happyTalents":{"value":""},"sheetLocked":{"value":false},"flags":{"dsa5-homebrew":{"is-tavern":false,"rolltables":{"0":{"name":"Backwerk","qtyForm":"3d4","consumable":true},"1":{"name":"","qtyForm":"","consumable":false},"2":{"name":"","qtyForm":"","consumable":false},"3":{"name":"","qtyForm":"","consumable":false},"4":{"name":"","qtyForm":"","consumable":false},"5":{"name":"","qtyForm":"","consumable":false},"6":{"name":"","qtyForm":"","consumable":false},"7":{"name":"","qtyForm":"","consumable":false}},"tavern-name":"Zum tropfenden Hahn"}}},"sort":100001,"flags":{"core":{"sheetClass":"dsa5.MerchantsAndTavernsNPC"},"dsa5-homebrew":{"products":[{"name":"Backwerk","consumable":true,"items":[{"_id":"tJnULysP4X13Vrew","pack":"dsa5-homebrew.item-food","name":"Brot","img":"modules/dsa5-homebrew/images/items/food/brot.png","price":0.15},{"_id":"4qbaA7JfzDDDbo9T","pack":"dsa5-homebrew.item-food","name":"Honigkuchen","img":"modules/dsa5-homebrew/images/items/food/honigkuchen.png","price":0.2},{"_id":"DjXvLZBIwJSb2Dah","pack":"dsa5-homebrew.item-food","name":"Brötchen","img":"modules/dsa5-homebrew/images/items/food/broetchen.png","price":0.03},{"_id":"lqpdLliK8u0B736b","pack":"dsa5-homebrew.item-food","name":"Bretzel","img":