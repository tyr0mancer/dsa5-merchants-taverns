otes":{"value":"<p><strong>Kampfverhalten:</strong> B&uuml;rger versuchen meist, gewaltt&auml;tigen Auseinandersetzungen aus dem Weg zu gehen. M&uuml;ssen sie sich doch einmal zur Wehr setzen, so greifen sie meist auf einen Kn&uuml;ppel oder ihren Dolch zur&uuml;ck, aber sie versuchen nach M&ouml;glichkeit zu fliehen. In &Uuml;berzahl, beispielsweise als emp&ouml;rter Mob, sind sie hingegen meist weitaus mutiger.</p>\n<p>&nbsp;</p>\n<p><strong>Flucht:</strong> individuell; sp&auml;testens nach einer Stufe Schmerz versuchen B&uuml;rger zu fliehen</p>","gmdescription":""},"Home":{"value":""}},"guidevalue":{"magical":"-","clerical":"-"},"energyfactor":{"magical":1,"clerical":1},"tradition":{"magical":"","clerical":""},"feature":{"magical":"","clerical":""},"happyTalents":{"value":""},"sheetLocked":{"value":false}},"sort":100001,"flags":{},"img":"icons/svg/mystery-man-black.svg","token":{"flags":{},"name":"Bürger","displayName":20,"img":"icons/svg/mystery-man-black.svg","tint":"","width":1,"height":1,"scale":1,"mirrorX":false,"mirrorY":false,"lockRotation":false,"rotation":0,"vision":false,"dimSight":0,"brightSight":0,"dimLight":0,"brightLight":0,"sightAngle":360,"lightAngle":360,"lightColor":"","lightAlpha":1,"lightAnimation":{"type":"","speed":5,"intensity":5},"actorId":"LH8uiamnpnfi6bFH","actorLink":false,"disposition":0,"displayBars":20,"bar1":{"attribute":"status.wounds"},"bar2":{"attribute":""},"randomImg":false},"items":[{"_id":"iMinlqOKzjRpnQFU","name":"Alchimie","type":"skill","data":{"group":{"value":"trade"},"talentValue":{"value":0},"characteristic1":{"value":"mu"},"characteristic2":{"value":"kl"},"characteristic3":{"value":"ff"},"RPr":{"value":"no"},"burden":{"value":"yes"},"description":{"value":""},"gmdescription":{"value":""},"StF":{"value":"C"}},"flags":{"core":{"sourceId":"Item.lHhXMnWsJ65R9NSR"}},"img":"systems/dsa5/icons/categories/Skill.webp","effects":[]},{"_id":"AJllkCyiX30nzVnk","name":"Bekehren & Überzeugen","type":"skill","data":{"group":{"valu