{"_id":"efUpbM41cyItB0As","name":"Kwassetz","permission":{"default":0,"x6UCOfoNvCw49QWl":3},"type":"equipment","data":{"price":{"value":0.16},"quantity":{"value":1},"weight":{"value":1},"effect":{"value":""},"description":{"value":"<p><strong>bornl&auml;ndisches Sauerbrotbier</strong></p>\n<p>Bornischer Kwassetz ist ein leicht alkoholisches Getr&auml;nk (\"Sauerbrotbier\"), das im Vergleich zum Meskinnes eher unbekannt ist.</p>"},"gmdescription":{"value":""},"equipmentType":{"value":"luxus"},"structure":{"max":0,"value":0}},"flags":{},"img":"material/items/taverne/bier-krug.png","effects":[]}
