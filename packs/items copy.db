{"_id":"8kxRc0QWwO84bCmi","name":"Felsteufel","permission":{"default":0,"x6UCOfoNvCw49QWl":3},"type":"equipment","data":{"price":{"value":0.3},"quantity":{"value":1},"weight":{"value":1},"effect":{"value":""},"description":{"value":"<p>Der Felsteufel ist ein Wein, der an den S&uuml;dh&auml;ngen des Eisenwaldes angebaut wird.</p>\n<p>&nbsp;</p>"},"gmdescription":{"value":""},"equipmentType":{"value":"luxus"},"structure":{"max":0,"value":0}},"flags":{},"img":"material/items/taverne/wein-becher.png","effects":[]}
