{"name":"Castello Ciarantalla","permission":{"default":0,"x6UCOfoNvCw49QWl":3},"type":"equipment","data":{"price":{"value":0.2},"quantity":{"value":1},"weight":{"value":1},"effect":{"value":""},"description":{"value":"<p>Der Castello Ciarantalla ist ein minderwertiger Wein aus dem Horasreich, der in h&ouml;fischen Kreisen einen schlechten Ruf genie&szlig;t.</p>"},"gmdescription":{"value":""},"equipmentType":{"value":"luxus"},"structure":{"max":0,"value":0}},"flags":{},"img":"material/items/taverne/wein-becher.png","effects":[],"_id":"Zz5UDZymPzrfxhMm"}
