{"name":"Brachfelder Bärenbiss","permission":{"default":0,"x6UCOfoNvCw49QWl":3},"type":"equipment","data":{"price":{"value":0.2},"quantity":{"value":1},"weight":{"value":1},"effect":{"value":""},"description":{"value":"<p>Der Brachfelder B&auml;renbiss (auch Brachfelder B&auml;renbei&szlig;) ist ein bekannter R&uuml;benschnaps aus Balsaith in Weiden.</p>\n<p>&nbsp;</p>"},"gmdescription":{"value":""},"equipmentType":{"value":"luxus"},"structure":{"max":0,"value":0}},"flags":{},"img":"material/items/taverne/schnaps-becher.png","effects":[],"_id":"7yUoKXyEcvncElgZ"}
