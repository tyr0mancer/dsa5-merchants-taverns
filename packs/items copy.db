{"name":"Axtschlag","permission":{"default":0,"x6UCOfoNvCw49QWl":3},"type":"equipment","data":{"price":{"value":0.2},"quantity":{"value":1},"weight":{"value":1},"effect":{"value":""},"description":{"value":"<p>Der Axtschlag ist ein Schnaps aus den Nordmarken, dessen Name auf seine durchschlagende Wirkung hindeuten d&uuml;rfte.</p>"},"gmdescription":{"value":""},"equipmentType":{"value":"luxus"},"structure":{"max":0,"value":0}},"flags":{},"img":"material/items/taverne/schnaps-becher.png","effects":[],"_id":"hpON2hSu5SoEeQXZ"}
{"name":"Warunker Rambelbost","permission":{"default":0,"x6UCOfoNvCw49QWl":3},"type":"equipment","data":{"price":{"value":0.2},"quantity":{"value":1},"weight":{"value":1},"effect":{"value":""},"description":{"value":"<p>Beim Warunker Rambelbost handelt es sich um einen hochprozentigen Schnaps aus der Markgrafschaft Warunk.</p>"},"gmdescription":{"value":""},"equipmentType":{"value":"luxus"},"structure":{"max":0,"value":0}},"flags":{},"img":"material/items/taverne/schnaps-becher.png","effects":[],"_id":"jbHETC6Wafi2ltCB"}
