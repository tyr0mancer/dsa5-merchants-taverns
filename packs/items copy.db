{"name":"Trollberger","permission":{"default":0,"x6UCOfoNvCw49QWl":3},"type":"equipment","data":{"price":{"value":0.4},"quantity":{"value":1},"weight":{"value":1},"effect":{"value":""},"description":{"value":"<p>Der Trollberger ist ein fruchtiger Wein, der aus den gleichnamigen im Nordm&auml;rker Fuchsgau wachsenden Trauben gekeltert wird. Er bildet mit dem Roten Geron, dem Wei&szlig;en Geron und dem Schwarzen Elenviner die Grundlage f&uuml;r den Elenviner.</p>\n<p>&nbsp;</p>\n<p>Der Wein ist nicht mit dem gleichnamigen aus Darpatien stammenden Schnaps zu verwechseln.</p>\n<p>&nbsp;</p>"},"gmdescription":{"value":""},"equipmentType":{"value":"luxus"},"structure":{"max":0,"value":0}},"flags":{},"img":"material/items/taverne/wein-becher.png","effects":[],"_id":"vkfpURB3TNM7rgOq"}
{"name":"Dergelsteiner Zwetschg","permission":{"default":0,"x6UCOfoNvCw49QWl":3},"type":"equipment","data":{"price":{"value":0.2},"quantity":{"value":1},"weight":{"value":1},"effect":{"value":""},"description":{"value":"<p>Der Dergelsteiner Zwetschg ist ein minder starker Pflaumenschnaps aus Greifenfurt</p>"},"gmdescription":{"value":""},"equipmentType":{"value":"luxus"},"structure":{"max":0,"value":0}},"flags":{},"img":"material/items/taverne/schnaps-becher.png","effects":[],"_id":"xYzdK3Zf4NbuE9Ae"}
