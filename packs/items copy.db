{"name":"Rallerspforter Quellwasser","permission":{"default":0,"x6UCOfoNvCw49QWl":3},"type":"equipment","data":{"price":{"value":0.2},"quantity":{"value":1},"weight":{"value":1},"effect":{"value":""},"description":{"value":"<p><span style=\"font-family: Helvetica Neue, Nimbus Sans, Helvetica, Arial, sans-serif;\"><span style=\"font-size: 12.8px;\">Beim Rallerspforter Quellwasser handelt es sich mitnichten um klares Wasser, sondern um einen hochprozentigen Schnaps aus dem westlichen K&ouml;nigreich Garetien</span></span></p>"},"gmdescription":{"value":""},"equipmentType":{"value":"luxus"},"structure":{"max":0,"value":0}},"flags":{},"img":"material/items/taverne/schnaps-becher.png","effects":[],"_id":"Be5FEmP77E9V5ytE"}
