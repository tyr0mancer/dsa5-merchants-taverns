{"name":"Nostrier Knat","permission":{"default":0,"x6UCOfoNvCw49QWl":3},"type":"equipment","data":{"price":{"value":0.2},"quantity":{"value":1},"weight":{"value":1},"effect":{"value":""},"description":{"value":"<p>Knat ist ein nostrisches Bier, das durch die W&uuml;rzung mittels Gem&uuml;se, insbesondere Spinat, eine stark gr&uuml;ne Farbe bekommt.</p>\n<p>Eine Mischung aus Knat und Gnitzer wurde in den Baronien Cres und Gnitzenkuhl zu Gnatzer weiterentwickelt.</p>\n<p>&nbsp;</p>\n<p>&nbsp;</p>"},"gmdescription":{"value":""},"equipmentType":{"value":"luxus"},"structure":{"max":0,"value":0}},"flags":{},"img":"material/items/taverne/bier-krug.png","effects":[],"_id":"3mNGkq6Y2lXthAO8"}
